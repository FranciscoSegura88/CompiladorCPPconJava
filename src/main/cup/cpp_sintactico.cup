/*---------------------------
| SEGURA VALENCIA FRANCISCO |
---------------------------*/

package com.compilador.parser;

import java_cup.runtime.*;
import java.util.List;
import java.util.ArrayList;
import com.compilador.lexico.ScannerLexicoCpp;
import com.compilador.CompilerError;
import com.compilador.CompilerError.TipoError;
import com.compilador.semantico.SymbolTable;
import com.compilador.semantico.SymbolTable.Simbolo;
import com.compilador.semantico.SemanticError;
import com.compilador.semantico.SemanticError.TipoErrorSem;

parser code {:
    private ScannerLexicoCpp scanner;
    public  SymbolTable         tablaSimbolos = new SymbolTable();
    public  List<SemanticError> erroresSem    = new ArrayList<>();

    public parser(ScannerLexicoCpp scanner) {
        this(scanner, new DefaultSymbolFactory());
        this.scanner = scanner;
    }

    @Override
    public void report_error(String mensaje, Object info) {
        int linea = 0, columna = 0; String token = "";
        if (info instanceof Symbol) {
            Symbol s = (Symbol) info;
            linea = s.left; columna = s.right;
            if (s.value != null) token = s.value.toString();
        }
        scanner.getErrors().add(
            new CompilerError(TipoError.SINTACTICO, mensaje, linea, columna, token));
    }
    @Override public void report_fatal_error(String m, Object i) { report_error(m, i); }
    @Override public void syntax_error(Symbol t) {}
    @Override public void unrecovered_syntax_error(Symbol t) {
        report_error("Error de sintaxis no recuperable", t);
    }

    public void errorSem(TipoErrorSem tipo, String msg, int lin, int col, String tok) {
        erroresSem.add(new SemanticError(tipo, msg, lin, col, tok));
    }

    public void declararSimbolo(String nombre, String tipo, boolean esConst,
                                String valor, int lin, int col) {
        boolean ok = tablaSimbolos.insertar(nombre, tipo, esConst, valor, lin, col);
        if (!ok) errorSem(TipoErrorSem.REDECLARACION,
            "Identificador '" + nombre + "' ya declarado en este ámbito",
            lin, col, nombre);
    }

    /** Como declararSimbolo pero retorna true si se insertó (false = redeclaración) */
    public boolean declararSimboloConRetorno(String nombre, String tipo, boolean esConst,
                                             String valor, int lin, int col) {
        boolean ok = tablaSimbolos.insertar(nombre, tipo, esConst, valor, lin, col);
        if (!ok) errorSem(TipoErrorSem.REDECLARACION,
            "Identificador '" + nombre + "' ya declarado en este ámbito",
            lin, col, nombre);
        return ok;
    }

    public String verificarUso(String nombre, int lin, int col) {
        Simbolo s = tablaSimbolos.buscar(nombre);
        if (s == null) {
            errorSem(TipoErrorSem.NO_DECLARADO,
                "Identificador '" + nombre + "' no declarado", lin, col, nombre);
            return "unknown";
        }
        if (!s.inicializado)
            errorSem(TipoErrorSem.USO_ANTES_DE_DECLARAR,
                "Variable '" + nombre + "' usada antes de ser inicializada",
                lin, col, nombre);
        return s.tipo;
    }

    /** Solo verifica que esté declarado — no checa inicialización. Usar en LHS de asignación pura. */
    public String verificarDeclarado(String nombre, int lin, int col) {
        Simbolo s = tablaSimbolos.buscar(nombre);
        if (s == null) {
            errorSem(TipoErrorSem.NO_DECLARADO,
                "Identificador '" + nombre + "' no declarado", lin, col, nombre);
            return "unknown";
        }
        return s.tipo;
    }

    /** Declara un atributo de clase — marcado como inicializado (init por defecto en C++). */
    public void declararAtributo(String nombre, String tipo, int lin, int col) {
        boolean ok = tablaSimbolos.insertar(nombre, tipo, false, null, lin, col);
        if (!ok) {
            errorSem(TipoErrorSem.REDECLARACION,
                "Identificador '" + nombre + "' ya declarado en este ámbito", lin, col, nombre);
        } else {
            Simbolo s = tablaSimbolos.buscarEnAmbitoActual(nombre);
            if (s != null) s.inicializado = true;
        }
    }

    /** Declara un parámetro formal — siempre marcado como inicializado. */
    public void declararParametro(String nombre, String tipo, int lin, int col) {
        boolean ok = tablaSimbolos.insertar(nombre, tipo, false, null, lin, col);
        if (!ok) {
            errorSem(TipoErrorSem.REDECLARACION,
                "Parámetro '" + nombre + "' duplicado en este método", lin, col, nombre);
        } else {
            Simbolo s = tablaSimbolos.buscarEnAmbitoActual(nombre);
            if (s != null) s.inicializado = true;
        }
    }

    public void verificarAsignacion(String nombre, String tipoExpr, int lin, int col) {
        Simbolo s = tablaSimbolos.buscar(nombre);
        if (s == null) return;
        if (s.esConstante) {
            errorSem(TipoErrorSem.CONSTANTE_REASIGNADA,
                "No se puede reasignar la constante '" + nombre + "'",
                lin, col, nombre);
            return;
        }
        if (tipoExpr != null && !tipoExpr.equals("unknown") &&
            !SymbolTable.sonCompatibles(s.tipo, tipoExpr))
            errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                "Tipo incompatible: no se puede asignar '" + tipoExpr +
                "' a '" + nombre + "' de tipo '" + s.tipo + "'",
                lin, col, nombre);
        else
            tablaSimbolos.actualizarValor(nombre, tipoExpr);
    }

    /** Verifica operación aritmética binaria: ambos operandos deben ser numéricos. */
    public String verificarAritmetico(String t1, String t2, String op, int lin, int col) {
        if (t1 == null || t2 == null || "unknown".equals(t1) || "unknown".equals(t2))
            return "unknown";
        String res = SymbolTable.tipoResultanteAritmetico(t1, t2);
        if (res == null) {
            errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                "Operador '" + op + "' requiere operandos numéricos (int/float/double), " +
                "se encontraron tipos '" + t1 + "' y '" + t2 + "'",
                lin, col, op);
            return "unknown";
        }
        return res;
    }

    /** Verifica negación unaria: el operando debe ser numérico. */
    public String verificarNegacion(String t, int lin, int col) {
        if (t == null || "unknown".equals(t)) return "unknown";
        java.util.Set<String> num = java.util.Set.of("int","float","double");
        if (!num.contains(t)) {
            errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                "Operador unario '-' requiere operando numérico, se encontró tipo '" + t + "'",
                lin, col, "-");
            return "unknown";
        }
        return t;
    }

    /** Verifica operadores lógicos binarios (&&, ||): ambos operandos deben ser bool. */
    public String verificarLogico(String t1, String t2, String op, int lin, int col) {
        if (!"unknown".equals(t1) && !"bool".equals(t1))
            errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                "Operador '" + op + "' requiere operandos booleanos, " +
                "operando izquierdo es de tipo '" + t1 + "'",
                lin, col, op);
        if (!"unknown".equals(t2) && !"bool".equals(t2))
            errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                "Operador '" + op + "' requiere operandos booleanos, " +
                "operando derecho es de tipo '" + t2 + "'",
                lin, col, op);
        return "bool";
    }

    /** Verifica operador NOT (!): el operando debe ser bool. */
    public String verificarNot(String t, int lin, int col) {
        if (t != null && !"unknown".equals(t) && !"bool".equals(t))
            errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                "Operador '!' requiere operando booleano, se encontró tipo '" + t + "'",
                lin, col, "!");
        return "bool";
    }

    /** Verifica comparación: los tipos deben ser compatibles entre sí. */
    public String verificarComparacion(String t1, String t2, String op, int lin, int col) {
        if (t1 == null || t2 == null) return "bool";
        if ("unknown".equals(t1) || "unknown".equals(t2)) return "bool";
        java.util.Set<String> num = java.util.Set.of("int","float","double");
        boolean n1 = num.contains(t1), n2 = num.contains(t2);
        if (n1 != n2) {
            errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                "Comparación '" + op + "' inválida entre tipo numérico '" +
                (n1 ? t1 : t2) + "' y tipo no numérico '" + (n1 ? t2 : t1) + "'",
                lin, col, op);
            return "bool";
        }
        if (!op.equals("==") && !op.equals("!=") &&
            ("bool".equals(t1) || "string".equals(t1))) {
            errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                "Operador de comparación '" + op + "' no aplicable a tipo '" + t1 + "'",
                lin, col, op);
        }
        return "bool";
    }
:};

/*═══════════════ TERMINALES ═══════════════*/
terminal PR_INT, PR_FLOAT, PR_BOOL, PR_CHAR, PR_STRING, PR_DOUBLE;
terminal PR_VOID, PR_MAIN;
terminal PR_IF, PR_ELSE, PR_WHILE, PR_DO, PR_RETURN;
terminal PR_INCLUDE, PR_STD, PR_COUT, PR_CIN;
terminal PR_USING, PR_NAMESPACE, PR_ENDL;
terminal LIB_IOSTREAM;
terminal PR_CLASS, PR_CONST;
terminal PR_PUBLIC, PR_PRIVATE, PR_PROTECTED;
terminal OP_SUMA, OP_RESTA, OP_MULT, OP_DIV;
terminal OP_ASIG, OP_IGUAL, OP_DIF;
terminal OP_MENOR, OP_MAYOR, OP_MENOR_IGUAL, OP_MAYOR_IGUAL;
terminal OP_AND, OP_OR, OP_NOT;
terminal OP_FLUJO_SAL, OP_FLUJO_ENT;
terminal OP_INC, OP_DEC;
terminal OP_SUMA_ASIG, OP_RESTA_ASIG;
terminal PUNTO_COMA, COMA, HASH;
terminal PAREN_IZQ, PAREN_DER;
terminal LLAVE_IZQ, LLAVE_DER;
terminal DOBLE_DOS, DOS_PUNTOS;
terminal String  ID;
terminal Integer LIT_ENTERO;
terminal Double  LIT_DECIMAL;
terminal String  LIT_STRING;
terminal String  LIT_CHAR;
terminal Boolean LIT_BOOL;

/*═══════════════ NO TERMINALES ═══════════════*/
non terminal programa;
non terminal lista_directivas, directiva;
non terminal lista_clases, clase, abre_clase;
non terminal cuerpo_clase, lista_miembros_clase, miembro_clase;
non terminal seccion_acceso;
non terminal atributo, constante;
non terminal declaracion_metodo;
non terminal String tipo;
non terminal String valor;
non terminal parametros, lista_parametros, parametro;
non terminal cuerpo_metodo, cuerpo_metodo_tail;
non terminal lista_sentencias, sentencia;
non terminal variable;
non terminal String expr;
non terminal args_llamada, lista_args;
non terminal abre_metodo, abre_main;
non terminal flujo_salida;

/*═══════════════ PRECEDENCIA ═══════════════*/
precedence left  OP_OR;
precedence left  OP_AND;
precedence left  OP_IGUAL, OP_DIF;
precedence left  OP_MENOR, OP_MAYOR, OP_MENOR_IGUAL, OP_MAYOR_IGUAL;
precedence left  OP_SUMA, OP_RESTA;
precedence left  OP_MULT, OP_DIV;
precedence right OP_NOT, OP_INC, OP_DEC;

start with programa;

/*═══════════════ REGLAS ═══════════════*/

programa ::= lista_directivas lista_clases | lista_clases ;

/* ── Directivas ── */
lista_directivas ::= lista_directivas directiva | directiva ;
directiva
    ::= HASH PR_INCLUDE OP_MENOR LIB_IOSTREAM OP_MAYOR
    |   HASH PR_INCLUDE OP_MENOR ID OP_MAYOR
    |   PR_USING PR_NAMESPACE PR_STD PUNTO_COMA
    |   HASH PR_INCLUDE error
        {: parser.report_error("Directiva #include inválida", CUP$parser$stack.peek()); :}
    ;

/* ── Clases ── */
lista_clases ::= lista_clases clase | clase ;

/* abre_clase es un no-terminal vacío que ejecuta enterScope inmediatamente
   al ver el nombre de la clase, antes de procesar el cuerpo */

clase
    ::= PR_CLASS ID:n abre_clase LLAVE_IZQ cuerpo_clase LLAVE_DER
        {: parser.tablaSimbolos.exitScope(); :}
    |   PR_CLASS ID:n abre_clase LLAVE_IZQ cuerpo_clase LLAVE_DER PUNTO_COMA
        {: parser.tablaSimbolos.exitScope(); :}
    |   PR_CLASS error LLAVE_IZQ cuerpo_clase LLAVE_DER
        {: parser.report_error("Nombre de clase inválido", CUP$parser$stack.peek()); :}
    ;

abre_clase
    ::= /* vacío */
        {: // El ID ya está en el stack: buscamos el nombre de la clase
           Symbol idSym = (Symbol) CUP$parser$stack.elementAt(CUP$parser$top);
           String nombre = idSym.value != null ? idSym.value.toString() : "clase";
           parser.tablaSimbolos.enterScope(nombre); :}
    ;

cuerpo_clase   ::= lista_miembros_clase | /* vacío */ ;
lista_miembros_clase ::= lista_miembros_clase miembro_clase | miembro_clase ;
miembro_clase
    ::= seccion_acceso | atributo | constante | declaracion_metodo
    |   error PUNTO_COMA
        {: parser.report_error("Declaración inválida en cuerpo de clase",
               CUP$parser$stack.peek()); :}
    ;

seccion_acceso
    ::= PR_PUBLIC    DOS_PUNTOS
    |   PR_PRIVATE   DOS_PUNTOS
    |   PR_PROTECTED DOS_PUNTOS
    |   PR_PUBLIC    error {: parser.report_error("Falta ':' después de 'public'",    CUP$parser$stack.peek()); :}
    |   PR_PRIVATE   error {: parser.report_error("Falta ':' después de 'private'",   CUP$parser$stack.peek()); :}
    |   PR_PROTECTED error {: parser.report_error("Falta ':' después de 'protected'", CUP$parser$stack.peek()); :}
    ;

/* ── Atributos (solo un ID por declaración para evitar conflictos) ── */
atributo
    ::= tipo:t ID:n PUNTO_COMA
        {: parser.declararAtributo((String)n,(String)t,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).right); :}
    |   tipo:t ID:n OP_ASIG valor:v PUNTO_COMA
        {: parser.declararSimbolo((String)n,(String)t,false,(String)v,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-4)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-4)).right); :}
    |   tipo:t ID:n OP_ASIG valor error
        {: parser.report_error("Falta ';' en declaración de atributo",
               CUP$parser$stack.peek()); :}
    ;

/* ── Constantes ── */
constante
    ::= PR_CONST tipo:t ID:n OP_ASIG valor:v PUNTO_COMA
        {: parser.declararSimbolo((String)n,(String)t,true,(String)v,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-4)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-4)).right); :}
    |   PR_CONST tipo ID PUNTO_COMA
        {: parser.report_error("Constante debe inicializarse", CUP$parser$stack.peek()); :}
    |   PR_CONST tipo ID error
        {: parser.report_error("Constante debe inicializarse", CUP$parser$stack.peek()); :}
    |   PR_CONST tipo ID OP_ASIG valor error
        {: parser.report_error("Falta ';' al final de la constante", CUP$parser$stack.peek()); :}
    ;

/* ── Métodos ── */
declaracion_metodo
    ::= tipo:t ID:n abre_metodo PAREN_IZQ parametros PAREN_DER LLAVE_IZQ cuerpo_metodo LLAVE_DER
        {: parser.tablaSimbolos.exitScope();
           if (parser.tablaSimbolos.buscarEnAmbitoActual("__m__"+(String)n) != null)
               parser.errorSem(TipoErrorSem.METODO_DUPLICADO,
                   "Método '" + n + "' ya declarado",
                   ((Symbol)CUP$parser$stack.peek()).left,
                   ((Symbol)CUP$parser$stack.peek()).right, (String)n);
           else
               parser.tablaSimbolos.insertar("__m__"+(String)n,(String)t,false,null,
                   ((Symbol)CUP$parser$stack.peek()).left,
                   ((Symbol)CUP$parser$stack.peek()).right); :}

    |   tipo PR_MAIN abre_main PAREN_IZQ parametros PAREN_DER LLAVE_IZQ cuerpo_metodo LLAVE_DER
        {: parser.tablaSimbolos.exitScope(); :}

    |   ID PAREN_IZQ parametros PAREN_DER LLAVE_IZQ cuerpo_metodo LLAVE_DER
        {: parser.report_error("Tipo de retorno inválido", CUP$parser$stack.peek()); :}

    |   tipo ID LLAVE_IZQ cuerpo_metodo LLAVE_DER
        {: parser.report_error("Falta '(' o ')' en declaración de método",
               CUP$parser$stack.peek()); :}

    |   ID PAREN_IZQ error LLAVE_DER
        {: parser.report_error("Tipo de retorno inválido o parámetros malformados",
               CUP$parser$stack.peek()); :}
    ;

abre_metodo
    ::= /* vacío */
        {: Symbol idSym = (Symbol) CUP$parser$stack.elementAt(CUP$parser$top);
           String nombre = (idSym.value != null) ? idSym.value.toString() : "metodo";
           parser.tablaSimbolos.enterScope(nombre); :}
    ;

abre_main
    ::= /* vacío */
        {: parser.tablaSimbolos.enterScope("main"); :}
    ;

/* ── Tipos ── */
tipo
    ::= PR_INT    {: RESULT="int";    :} | PR_FLOAT  {: RESULT="float";  :}
    |   PR_DOUBLE {: RESULT="double"; :} | PR_BOOL   {: RESULT="bool";   :}
    |   PR_CHAR   {: RESULT="char";   :} | PR_STRING {: RESULT="string"; :}
    |   PR_VOID   {: RESULT="void";   :} | ID:n      {: RESULT=(String)n; :}
    ;

/* ── Valores literales ── */
valor
    ::= LIT_ENTERO              {: RESULT="int";    :}
    |   LIT_DECIMAL             {: RESULT="float";  :}
    |   LIT_STRING              {: RESULT="string"; :}
    |   LIT_CHAR                {: RESULT="char";   :}
    |   LIT_BOOL                {: RESULT="bool";   :}
    |   ID:n                    {: RESULT=parser.verificarUso((String)n,
                                       ((Symbol)CUP$parser$stack.peek()).left,
                                       ((Symbol)CUP$parser$stack.peek()).right); :}
    |   OP_RESTA LIT_ENTERO     {: RESULT="int";    :}
    |   OP_RESTA LIT_DECIMAL    {: RESULT="float";  :}
    ;

/* ── Parámetros ── */
parametros ::= lista_parametros | /* vacío */ ;
lista_parametros
    ::= lista_parametros COMA parametro
    |   lista_parametros COMA
        {: parser.report_error("Parámetro inválido (coma sobrante)", CUP$parser$stack.peek()); :}
    |   parametro
    ;
parametro
    ::= tipo:t ID:n
        {: parser.declararParametro((String)n,(String)t,
               ((Symbol)CUP$parser$stack.peek()).left,
               ((Symbol)CUP$parser$stack.peek()).right); :}
    |   tipo error
        {: parser.report_error("Parámetro inválido (falta nombre o falta ',')",
               CUP$parser$stack.peek()); :}
    ;

/* ── Cuerpo de método ── */
cuerpo_metodo ::= cuerpo_metodo_tail | /* vacío */ ;
cuerpo_metodo_tail
    ::= lista_sentencias
    |   lista_sentencias error
        {: parser.report_error("Falta ';' en la última declaración del método",
               CUP$parser$stack.peek()); :}
    |   error
        {: parser.report_error("Error en cuerpo de método", CUP$parser$stack.peek()); :}
    ;

lista_sentencias
    ::= lista_sentencias sentencia
    |   lista_sentencias error PUNTO_COMA
        {: parser.report_error("Declaración inválida en cuerpo de método",
               CUP$parser$stack.peek()); :}
    |   sentencia
    |   error PUNTO_COMA
        {: parser.report_error("Declaración inválida en cuerpo de método",
               CUP$parser$stack.peek()); :}
    ;

/* ── Sentencias ── */
sentencia
    /* declaración de variable */
    ::= variable

    /* asignación: x = expr; */
    |   ID:n OP_ASIG expr:t PUNTO_COMA
        {: int l=((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-3)).left;
           int c=((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-3)).right;
           parser.verificarDeclarado((String)n,l,c);
           parser.verificarAsignacion((String)n,(String)t,l,c); :}

    /* x += expr; */
    |   ID:n OP_SUMA_ASIG expr:te PUNTO_COMA
        {: int l=((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-3)).left;
           int c=((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-3)).right;
           String tn=parser.verificarUso((String)n,l,c);
           parser.verificarAritmetico(tn,(String)te,"+=",l,c); :}

    /* x -= expr; */
    |   ID:n OP_RESTA_ASIG expr:te PUNTO_COMA
        {: int l=((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-3)).left;
           int c=((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-3)).right;
           String tn=parser.verificarUso((String)n,l,c);
           parser.verificarAritmetico(tn,(String)te,"-=",l,c); :}

    /* x++; x--; */
    |   ID:n OP_INC PUNTO_COMA
        {: parser.verificarUso((String)n,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).right); :}
    |   ID:n OP_DEC PUNTO_COMA
        {: parser.verificarUso((String)n,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).right); :}

    /* llamada: metodo(args); */
    |   ID:n PAREN_IZQ args_llamada PAREN_DER PUNTO_COMA
        {: if (parser.tablaSimbolos.buscar("__m__"+(String)n)==null)
               parser.errorSem(TipoErrorSem.NO_DECLARADO,
                   "Método '"+n+"' no declarado",
                   ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-4)).left,
                   ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-4)).right,(String)n); :}

    /* cout << expr << expr << endl; */
    |   PR_COUT flujo_salida PUNTO_COMA

    /* cin >> ID; */
    |   PR_CIN OP_FLUJO_ENT ID:n PUNTO_COMA
        {: parser.verificarUso((String)n,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).right); :}

    /* return */
    |   PR_RETURN expr PUNTO_COMA
    |   PR_RETURN PUNTO_COMA

    /* if / if-else */
    |   PR_IF PAREN_IZQ expr PAREN_DER LLAVE_IZQ lista_sentencias LLAVE_DER
    |   PR_IF PAREN_IZQ expr PAREN_DER LLAVE_IZQ lista_sentencias LLAVE_DER
        PR_ELSE LLAVE_IZQ lista_sentencias LLAVE_DER

    /* while */
    |   PR_WHILE PAREN_IZQ expr PAREN_DER LLAVE_IZQ lista_sentencias LLAVE_DER
    ;

/* ── Expresiones ── */
expr
    ::= expr:a OP_SUMA  expr:b
        {: RESULT=parser.verificarAritmetico((String)a,(String)b,"+",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_RESTA expr:b
        {: RESULT=parser.verificarAritmetico((String)a,(String)b,"-",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_MULT  expr:b
        {: RESULT=parser.verificarAritmetico((String)a,(String)b,"*",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_DIV   expr:b
        {: RESULT=parser.verificarAritmetico((String)a,(String)b,"/",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_IGUAL       expr:b
        {: RESULT=parser.verificarComparacion((String)a,(String)b,"==",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_DIF         expr:b
        {: RESULT=parser.verificarComparacion((String)a,(String)b,"!=",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_MENOR       expr:b
        {: RESULT=parser.verificarComparacion((String)a,(String)b,"<",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_MAYOR       expr:b
        {: RESULT=parser.verificarComparacion((String)a,(String)b,">",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_MENOR_IGUAL expr:b
        {: RESULT=parser.verificarComparacion((String)a,(String)b,"<=",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_MAYOR_IGUAL expr:b
        {: RESULT=parser.verificarComparacion((String)a,(String)b,">=",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_AND expr:b
        {: RESULT=parser.verificarLogico((String)a,(String)b,"&&",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   expr:a OP_OR  expr:b
        {: RESULT=parser.verificarLogico((String)a,(String)b,"||",
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   OP_NOT expr:t
        {: RESULT=parser.verificarNot((String)t,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   OP_RESTA expr:t
        {: RESULT=parser.verificarNegacion((String)t,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-1)).right); :}
    |   PAREN_IZQ expr:t PAREN_DER {: RESULT=(String)t; :}
    /* llamada dentro de expr: f(args) */
    |   ID:n PAREN_IZQ args_llamada PAREN_DER
        {: Simbolo m=parser.tablaSimbolos.buscar("__m__"+(String)n);
           if (m==null) {
               parser.errorSem(TipoErrorSem.NO_DECLARADO,"Método '"+n+"' no declarado",
                   ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-3)).left,
                   ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-3)).right,(String)n);
               RESULT="unknown";
           } else RESULT=m.tipo; :}
    /* literales e IDs */
    |   LIT_ENTERO              {: RESULT="int";    :}
    |   LIT_DECIMAL             {: RESULT="float";  :}
    |   LIT_STRING              {: RESULT="string"; :}
    |   LIT_CHAR                {: RESULT="char";   :}
    |   LIT_BOOL                {: RESULT="bool";   :}
    |   ID:n
        {: RESULT=parser.verificarUso((String)n,
               ((Symbol)CUP$parser$stack.peek()).left,
               ((Symbol)CUP$parser$stack.peek()).right); :}
    ;

/* ── Args de llamada ── */
args_llamada ::= lista_args | /* vacío */ ;
lista_args   ::= lista_args COMA expr | expr ;

/* ── Flujo de salida (cout << a << b << endl) ── */
flujo_salida
    ::= flujo_salida OP_FLUJO_SAL expr
    |   flujo_salida OP_FLUJO_SAL PR_ENDL
    |   OP_FLUJO_SAL expr
    |   OP_FLUJO_SAL PR_ENDL
    ;

/* ── Variables (solo un ID por producción) ── */
variable
    /* int x; */
    ::= tipo:t ID:n PUNTO_COMA
        {: parser.declararSimbolo((String)n,(String)t,false,null,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).left,
               ((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-2)).right); :}

    /* int x = expr; */
    |   tipo:t ID:n OP_ASIG expr:te PUNTO_COMA
        {: int l=((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-4)).left;
           int c=((Symbol)CUP$parser$stack.elementAt(CUP$parser$top-4)).right;
           boolean ok = parser.declararSimboloConRetorno((String)n,(String)t,false,(String)te,l,c);
           if (ok && te!=null && !te.equals("unknown") &&
               !SymbolTable.sonCompatibles((String)t,(String)te)) {
               parser.errorSem(TipoErrorSem.TIPO_INCOMPATIBLE,
                   "Tipo incompatible: no se puede asignar '"+te+
                   "' a '"+n+"' de tipo '"+t+"'",l,c,(String)n);
               // forzar inserción para que no aparezca como "no declarado" después
               parser.tablaSimbolos.insertarForzado((String)n,(String)t,false,null,l,c);
           } :}

    /* error: falta ; */
    |   tipo:t ID:n OP_ASIG expr error
        {: parser.report_error("Falta ';' en declaración de variable",
               CUP$parser$stack.peek()); :}
    ;
