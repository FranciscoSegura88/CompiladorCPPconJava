package com.compilador.parser;

import java_cup.runtime.*;
import com.compilador.lexico.ScannerLexicoCpp;
import com.compilador.CompilerError;
import com.compilador.CompilerError.TipoError;

/*═══════════════════════════════════════════════════════
  CÓDIGO INYECTADO EN LA CLASE parser
═══════════════════════════════════════════════════════*/

parser code {:

    private ScannerLexicoCpp scanner;

    public parser(ScannerLexicoCpp scanner) {
        this(scanner, new DefaultSymbolFactory());
        this.scanner = scanner;
    }

    @Override
    public void report_error(String mensaje, Object info) {
        int linea   = 0;
        int columna = 0;
        String token = "";

        if (info instanceof Symbol) {
            Symbol s = (Symbol) info;
            linea   = s.left;
            columna = s.right;
            if (s.value != null) token = s.value.toString();
        }

        scanner.getErrors().add(
            new CompilerError(TipoError.SINTACTICO, mensaje, linea, columna, token)
        );
    }

    @Override
    public void report_fatal_error(String mensaje, Object info) {
        report_error(mensaje, info);
    }

    @Override
    public void syntax_error(Symbol cur_token) {
        // Silenciado — los errores los capturan las reglas error de la gramatica
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) {
        report_error("Error de sintaxis no recuperable", cur_token);
    }
:};

/*═══════════════════════════════════════════════════════
  TERMINALES
═══════════════════════════════════════════════════════*/

terminal PR_INT, PR_FLOAT, PR_BOOL, PR_CHAR, PR_STRING, PR_DOUBLE;
terminal PR_VOID, PR_MAIN;
terminal PR_IF, PR_ELSE, PR_WHILE, PR_DO, PR_RETURN;
terminal PR_INCLUDE, PR_STD, PR_COUT, PR_CIN;
terminal PR_USING, PR_NAMESPACE, PR_ENDL;
terminal LIB_IOSTREAM;

terminal OP_SUMA, OP_RESTA, OP_MULT, OP_DIV;
terminal OP_ASIG, OP_IGUAL, OP_DIF;
terminal OP_MENOR, OP_MAYOR, OP_MENOR_IGUAL, OP_MAYOR_IGUAL;
terminal OP_AND, OP_OR, OP_NOT;
terminal OP_FLUJO_SAL, OP_FLUJO_ENT;

terminal PUNTO_COMA, COMA, HASH;
terminal PAREN_IZQ, PAREN_DER;
terminal LLAVE_IZQ, LLAVE_DER;
terminal DOBLE_DOS;

terminal String  ID;
terminal Integer LIT_ENTERO;
terminal Double  LIT_DECIMAL;
terminal String  LIT_STRING;

/*═══════════════════════════════════════════════════════
  NO TERMINALES
═══════════════════════════════════════════════════════*/

non terminal programa;
non terminal lista_directivas, directiva;
non terminal lista_funciones,  declaracion_funcion;
non terminal tipo;
non terminal parametros, lista_parametros, parametro;
non terminal cuerpo_funcion;

/*═══════════════════════════════════════════════════════
  PRECEDENCIA
═══════════════════════════════════════════════════════*/

precedence left  OP_OR;
precedence left  OP_AND;
precedence left  OP_IGUAL,  OP_DIF;
precedence left  OP_MENOR,  OP_MAYOR, OP_MENOR_IGUAL, OP_MAYOR_IGUAL;
precedence left  OP_SUMA,   OP_RESTA;
precedence left  OP_MULT,   OP_DIV;
precedence right OP_NOT;

start with programa;

/*═══════════════════════════════════════════════════════
  REGLAS DE PRODUCCIÓN
═══════════════════════════════════════════════════════*/

programa
    ::= lista_directivas lista_funciones
    |   lista_funciones
    ;

/* ══════════════════════════════════
   DIRECTIVAS
══════════════════════════════════ */

lista_directivas
    ::= lista_directivas directiva
    |   directiva
    ;

directiva
    ::= HASH PR_INCLUDE OP_MENOR LIB_IOSTREAM OP_MAYOR
    |   HASH PR_INCLUDE OP_MENOR ID OP_MAYOR
    |   PR_USING PR_NAMESPACE PR_STD PUNTO_COMA
    |   HASH PR_INCLUDE error
        {: parser.report_error(
               "Directiva #include inválida",
               CUP$parser$stack.peek()); :}
    ;

/* ══════════════════════════════════
   FUNCIONES
══════════════════════════════════ */

lista_funciones
    ::= lista_funciones declaracion_funcion
    |   declaracion_funcion
    ;

declaracion_funcion
    ::= tipo ID PAREN_IZQ parametros PAREN_DER LLAVE_IZQ cuerpo_funcion LLAVE_DER

    |   tipo PR_MAIN PAREN_IZQ parametros PAREN_DER LLAVE_IZQ cuerpo_funcion LLAVE_DER

    |   tipo ID PAREN_IZQ parametros error LLAVE_IZQ cuerpo_funcion LLAVE_DER
        {: parser.report_error(
               "Falta '(' o ')' en declaración de función",
               CUP$parser$stack.peek()); :}

    |   tipo ID LLAVE_IZQ cuerpo_funcion LLAVE_DER
        {: parser.report_error(
               "Falta '(' o ')' en declaración de función",
               CUP$parser$stack.peek()); :}

    |   ID PAREN_IZQ parametros PAREN_DER LLAVE_IZQ cuerpo_funcion LLAVE_DER
        {: parser.report_error(
               "Tipo de retorno inválido",
               CUP$parser$stack.peek()); :}
    ;

/* ══════════════════════════════════
   TIPOS
══════════════════════════════════ */

tipo
    ::= PR_INT
    |   PR_FLOAT
    |   PR_DOUBLE
    |   PR_BOOL
    |   PR_CHAR
    |   PR_STRING
    |   PR_VOID
    |   ID
    ;

/* ══════════════════════════════════
   PARÁMETROS
══════════════════════════════════ */

parametros
    ::= lista_parametros
    |   /* sin parámetros */
    ;

lista_parametros
    ::= lista_parametros COMA parametro

    /* coma sobrante: float x, ) */
    |   lista_parametros COMA
        {: parser.report_error(
               "Parámetro inválido (coma sobrante al final de la lista)",
               CUP$parser$stack.peek()); :}

    |   parametro
    ;

parametro
    /* caso normal: int a */
    ::= tipo ID

    /* falta nombre o falta coma: int , int b  /  int a int b */
    |   tipo error
        {: parser.report_error(
               "Parámetro inválido (falta nombre o falta ',' entre parámetros)",
               CUP$parser$stack.peek()); :}
    ;

/* ══════════════════════════════════
   CUERPO DE FUNCIÓN (vacío por ahora)
══════════════════════════════════ */

cuerpo_funcion
    ::= /* vacío */
    ;
